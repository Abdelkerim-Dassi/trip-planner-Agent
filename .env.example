# Copy this file to .env and fill in your keys.

# Which LLM provider powers the agents: "openai" (default) or "groq".
# Groq has a free tier (https://console.groq.com) — set this to "groq" to
# run end-to-end for free.
# VOYAGENT_PROVIDER=groq

# --- OpenAI (used when VOYAGENT_PROVIDER=openai, the default) ---
OPENAI_API_KEY=sk-...
# Optional — OpenAI organization id.
OPENAI_ORGANIZATION_ID=org-...

# --- Groq (used when VOYAGENT_PROVIDER=groq) ---
# Free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# --- Gemini (optional, free key at https://aistudio.google.com) ---
# A second fallback when Groq is busy. ReelTrip uses Flash-Lite: the full
# Flash model allows only about 20 free requests a day.
# GEMINI_API_KEY=...

# Optional — models to fall back on, in order, when the main one is busy.
# Default: groq/qwen/qwen3.8-27b (when a Groq key is set), then
# gemini/gemini-3.5-flash-lite (when a Gemini key is set). "" disables.
# VOYAGENT_FALLBACK_MODEL=groq/qwen/qwen3.8-27b,gemini/gemini-3.5-flash-lite

# Optional — free Redis (https://upstash.com, no card) so reports, plans,
# caches and daily limits survive restarts of a free host.
# UPSTASH_REDIS_REST_URL=...
# UPSTASH_REDIS_REST_TOKEN=...

# Required — powers the web search tool (free tier at https://serper.dev).
SERPER_API_KEY=...

# Optional — second search provider (free 1,000 searches a month at
# https://tavily.com). When set, searches that aren't about TikTok go to Tavily
# first, which saves Serper credits; TikTok searches always use Serper.
# TAVILY_API_KEY=tvly-...

# Optional — daily limits that keep the app inside its free tiers. They reset
# at midnight UTC; 0 means unlimited. The first three are per visitor (per IP
# address), the last two are for everybody together.
# VOYAGENT_DAILY_CHECKS_PER_IP=12
# VOYAGENT_DAILY_PLANS_PER_IP=6
# VOYAGENT_DAILY_DISCOVERS_PER_IP=12
# VOYAGENT_DAILY_SEARCH_BUDGET=200
# VOYAGENT_DAILY_MCP_BUDGET=300

# Optional — override the default model and temperature.
# Default model is gpt-4o-mini (openai) or openai/gpt-oss-120b (groq).
# VOYAGENT_MODEL=openai/gpt-oss-120b
# VOYAGENT_TEMPERATURE=0.2

# Optional — Groq free-tier tuning (only used when provider=groq).
# Pause between agent steps to stay under the tokens-per-minute cap (set 0 on a
# paid tier), and how many times to wait out a 429 before giving up.
# GROQ_STEP_DELAY_SECONDS=5
# GROQ_NUM_RETRIES=8
